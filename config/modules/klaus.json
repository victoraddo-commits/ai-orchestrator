{
  "name": "klaus",
  "description": "Kai Legal Knowledge Acquisition & Update System — automated legal document discovery, ingestion, and indexing for the Ghana Legal Brain",
  "endpoints": ["/api/klaus/documents", "/api/klaus/sources", "/api/klaus/search"],
  "capabilities": ["legal_research", "document_ingestion", "citation_extraction", "embeddings"],
  "dependencies": ["core.klaus.schema", "core.klaus.document_processor", "core.klaus.vector_indexer"],
  "version": "0.2.0",
  "settings_schema": {
    "auto_ingest_enabled": {"type": "boolean", "default": true, "label": "Auto-ingest new documents"},
    "max_documents_per_run": {"type": "number", "default": 50, "label": "Max docs per ingestion run", "min": 5, "max": 500},
    "ingestion_interval_hours": {"type": "number", "default": 6, "label": "Ingestion interval (hours)", "min": 1, "max": 48}
  },
  "ops_actions": ["trigger_ingestion", "reindex_all", "validate_sources", "clear_ingestion_queue"]
}
