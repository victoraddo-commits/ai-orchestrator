// ===================== Arbitra — Economic OS (full dashboard) =====================
const ARB='/cc/arbitra';
async function arbG(p){return api(ARB+p);}
async function arbP(p,b){return api(ARB+p,{method:'POST',body:JSON.stringify(b||{})});}
function arbVal(id){const e=$(id);return e?String(e.value).trim():'';}
function arbNum(id){const s=arbVal(id);return s===''?undefined:Number(s);}
const ARB_TABS=[['overview','Overview'],['opportunities','Opportunities'],['ventures','Ventures'],['thesis','Thesis'],['decisions','Decisions'],['equity','Equity'],['dividends','Dividends'],['portfolio','Portfolio'],['compounding','Compounding'],['forecasts','Forecasts'],['redteam','Red Team'],['autonomy','Autonomy'],['activity','Activity']];

async function loadArbitra(){
  const el=$('arbitra-content'); if(!el) return;
  el.innerHTML='<span class="loading">loading…</span>';
  let health={}; try{health=await arbG('/health');}catch(e){}
  const ok=health&&health.ok;
  el.innerHTML='<div class="card"><h3>Arbitra — Economic OS <span class="badge '+(ok?'ok':'bad')+'">'+(ok?'online':'unreachable')+'</span> <span class="badge info">'+esc((health&&health.model)||'v1')+'</span><span class="card-header-actions"><button class="btn btn-xs btn-accent" onclick="arbRunCycle()">Run cycle</button><button class="btn btn-xs" onclick="loadArbitra()">Refresh</button></span></h3>'
    +'<div class="muted" style="font-size:0.62rem">Advisory economic brain — records &amp; recommends; execution stays in money-center · API 192.168.1.118:8096</div>'
    +'<div class="action-row" style="flex-wrap:wrap;gap:6px;margin-top:8px">'+ARB_TABS.map(t=>'<button class="btn btn-xs" data-arbtab="'+t[0]+'" onclick="arbTab(\''+t[0]+'\')">'+t[1]+'</button>').join('')+'</div></div>'
    +'<div id="arb-body"><span class="loading">loading…</span></div>';
