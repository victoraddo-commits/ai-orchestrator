// WebAuthn (FIDO2) — security-key enrollment / authentication (27A)
function _b64u(buf){return btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');}
function _b64uDec(s){s=s.replace(/-/g,'+').replace(/_/g,'/');while(s.length%4)s+='=';return Uint8Array.from(atob(s),c=>c.charCodeAt(0));}
async function waList(){const el=$('wa-results');try{const d=await api('/kai/webauthn/credentials');el.textContent='credentials: '+((d.credentials||[]).join(', ')||'none');}catch(e){el.textContent='error: '+e.message;}}
async function waEnroll(){
  const el=$('wa-results');
  if(!window.PublicKeyCredential){el.textContent='WebAuthn unavailable — needs HTTPS + a DOMAIN origin (the CC is served on a Tailscale IP).';return;}
  try{
    const ch=await api('/kai/webauthn/challenge');
    const uid=crypto.getRandomValues(new Uint8Array(16));
    const cred=await navigator.credentials.create({publicKey:{
      challenge:_b64uDec(ch.challenge), rp:{name:'Kai', id:location.hostname},
      user:{id:uid, name:'operator', displayName:'Kai operator'},
      pubKeyCredParams:[{type:'public-key',alg:-7},{type:'public-key',alg:-257}],
      authenticatorSelection:{userVerification:'preferred', residentKey:'preferred'},
      timeout:60000, attestation:'none'}});
    const r=await api('/kai/webauthn/register',{method:'POST',body:JSON.stringify({
      challenge:ch.challenge, clientDataJSON:_b64u(cred.response.clientDataJSON),
      attestationObject:_b64u(cred.response.attestationObject)})});
    el.textContent='enrolled: '+(r.credential_id||JSON.stringify(r));
  }catch(e){el.textContent='enroll error: '+e.message;}
}
async function waAuth(){
  const el=$('wa-results');
  try{
    const ch=await api('/kai/webauthn/challenge');
    const cred=await navigator.credentials.get({publicKey:{challenge:_b64uDec(ch.challenge),timeout:60000,userVerification:'preferred'}});
    const r=await api('/kai/webauthn/authenticate',{method:'POST',body:JSON.stringify({
      challenge:ch.challenge, credential_id:_b64u(cred.rawId),
      clientDataJSON:_b64u(cred.response.clientDataJSON),
      authenticatorData:_b64u(cred.response.authenticatorData),
      signature:_b64u(cred.response.signature)})});
    el.textContent='authenticated: sign_count='+r.sign_count;
  }catch(e){el.textContent='auth error: '+e.message;}
}
