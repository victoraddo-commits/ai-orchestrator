function arbTab(n){
  document.querySelectorAll('[data-arbtab]').forEach(b=>b.classList.toggle('btn-accent',b.getAttribute('data-arbtab')===n));
  const m={overview:arbTOverview,opportunities:arbTOpps,ventures:arbTVentures,thesis:arbTThesis,decisions:arbTDecisions,equity:arbTEquity,dividends:arbTDividends,portfolio:arbTPortfolio,compounding:arbTCompounding,forecasts:arbTForecasts,redteam:arbTRedTeam,autonomy:arbTAutonomy,activity:arbTActivity};
  (m[n]||arbTOverview)();
}
function arbBody(h){const b=$('arb-body');if(b)b.innerHTML=h;}
function arbMetric(l,v,c){return '<div class="metric"><span class="val" style="color:'+(c||'var(--accent)')+'">'+esc(v==null||v===''?'—':v)+'</span><span style="font-size:0.6rem;color:var(--fg-muted)">'+esc(l)+'</span></div>';}
function arbTbl(cols,rows){
  if(!rows||!rows.length) return '<p class="empty">none yet</p>';
  return '<div class="table-wrap"><table><thead><tr>'+cols.map(c=>'<th>'+esc(c)+'</th>').join('')+'</tr></thead><tbody>'+rows+'</tbody></table></div>';
}
async function arbRunCycle(){try{const d=await arbP('/arbitra/cycle',{});window.__arbDigest=(d.cycle&&d.cycle.ai_digest)||null;toast('cycle run'+(window.__arbDigest?' ('+window.__arbDigest.source+')':''));arbTab('overview');}catch(e){toast('cycle error: '+e.message,'err');}}

async function arbTOverview(){
  arbBody('<span class="loading">loading…</span>');
  const g=async p=>{try{return await arbG(p);}catch(e){return {error:e.message};}};
  const st=await g('/arbitra/status'), rep=await g('/arbitra/report');
  let h='<div class="card"><h3>Status</h3>';
  h+=st.error?('<span class="error-text">'+esc(st.error)+'</span>'):('<div class="metric-row">'+arbMetric('Opportunities',st.opportunities)+arbMetric('Ventures',st.ventures)+arbMetric('Active',st.active_ventures,'var(--warn)')+'</div>');
  h+='</div>';
  if(!rep.error){const p=rep.portfolio||{};
    h+='<div class="card"><h3>Economic report</h3><div class="metric-row">'+arbMetric('Revenue',p.revenue)+arbMetric('Expenses',p.expenses)+arbMetric('Net profit',(p.net_profit!=null?p.net_profit:p.profit))+arbMetric('Dividends paid',p.dividends_paid)+arbMetric('Autonomy','L'+rep.autonomy)+'</div>';
    if(rep.ventures&&rep.ventures.length) h+='<div class="table-wrap"><table><thead><tr><th>Lifecycle</th><th>Ventures</th></tr></thead><tbody>'+rep.ventures.map(v=>'<tr><td>'+esc(v.lifecycle_state)+'</td><td>'+esc(v.n)+'</td></tr>').join('')+'</tbody></table></div>';
    h+='</div>';
  } else h+='<div class="card"><span class="error-text">'+esc(rep.error)+'</span></div>';
  if(window.__arbDigest&&window.__arbDigest.text){
    const dg=window.__arbDigest;
    h+='<div class="card"><h3>AI digest '+(dg.source==='local'?'<span class="badge ok">local model</span>':'<span class="badge warn">'+esc(dg.source||'fallback')+'</span>')+' <span class="badge info">'+esc(dg.model||'')+'</span></h3><pre style="font-size:0.62rem;white-space:pre-wrap;word-break:break-word">'+esc(dg.text)+'</pre></div>';
  }
  arbBody(h);
}

