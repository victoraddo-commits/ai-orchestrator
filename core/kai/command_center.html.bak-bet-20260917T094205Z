<script>
// ── State ─────────────────────────────────────────────────────────
const S = {
  token: null, role: null, username: null,
  loadedPanels: new Set(), modules: [], providers: [], _confirmCb: null
};
const SK = 'kai_command_session_v3';
const PANEL_TITLES = {
  home:'home', modules:'modules', legal:'legal', 'ai-workforce':'workforce', money:'money', arbitra:'Arbitra',
  docker:'docker', airdrop:'airdrop', infrastructure:'infra',
  security:'security', settings:'settings', logs:'logs', telegram:'Telegram',
  'kai-chat':'Kai Chat', devices:'Devices', talent:'Talent', android:'Android', docs:'Documents', hubtel:'Hubtel',
  wireguard:'WireGuard', directives:'Directives',
  missions:'Missions', executive:'Executive', enhancements:'Enhancements', factory:'Factory',
  evolution:'Evolution', network:'Network', models:'Models', vault:'Vault', secondbrain:'2nd Brain',
  knowledge:'Knowledge', approvals:'Approvals', notifications:'Notify', backups:'Backups',
  sessions:'Sessions', emergency:'Emergency', roadmap:'Roadmap', learning:'Learning', enterprise:'Enterprise'
};

const $=id=>document.getElementById(id);
const esc=s=>{const d=document.createElement('div');d.textContent=s;return d.innerHTML;};

// ── Toast ─────────────────────────────────────────────────────────
function toast(msg, type='ok') {
  const t = $('toast'); t.textContent = msg; t.className = 'toast visible ' + type;
  clearTimeout(t._tid); t._tid = setTimeout(()=>t.classList.remove('visible'), 2800);
}

// ── Confirm Modal ─────────────────────────────────────────────────
function confirmAction(title, msg, cb) {
  $('confirm-title').textContent = title;
  $('confirm-msg').textContent = msg;
  $('confirm-error').classList.remove('visible');
  S._confirmCb = cb;
  $('confirm-modal').classList.add('visible');
}
function closeConfirm() { $('confirm-modal').classList.remove('visible'); S._confirmCb = null; }
function runConfirm() {
  if (S._confirmCb) { try { S._confirmCb(); } catch(e) { toast(e.message,'err'); } }
  closeConfirm();
}

// ── Auth ──────────────────────────────────────────────────────────
function getToken() {
  if (S.token) return S.token;
  try { const d=JSON.parse(localStorage.getItem(SK)||sessionStorage.getItem(SK)||'{}');
    S.token=d.token;S.role=d.role;S.username=d.username; } catch {}
  return S.token;
}
function saveToken(rem) {
  const d=JSON.stringify({token:S.token,role:S.role,username:S.username});
  (rem?localStorage:sessionStorage).setItem(SK,d);
}
function clearToken() {
  S.token=null;S.role=null;S.username=null;
  localStorage.removeItem(SK);sessionStorage.removeItem(SK);
}

async function api(path, opts={}) {
  const h={'Content-Type':'application/json',...(opts.headers||{})};
  if(S.token) h['X-Kai-Session']=S.token;
  const r=await fetch(path,{...opts,headers:h});
  if(r.status===401){clearToken();showLogin();throw new Error('Session expired');}
  if(!r.ok){
    let m=`HTTP ${r.status}`;
    try{const j=await r.json();m=j.detail||j.error||m;}catch{}
    throw new Error(m);
  }
  return r.json();
}

function showLogin() {
  $('login-screen').classList.remove('hidden');$('app-wrap').classList.remove('active');clearToken();
}
async function doLogin() {
  const u=$('login-user').value.trim(),p=$('login-pass').value,rem=$('login-remember').checked;
  const err=$('login-error'),btn=$('login-btn');
  if(!u||!p){err.textContent='Username and password are required.';err.classList.add('visible');return;}
  btn.disabled=true;btn.innerHTML='Signing in…';err.classList.remove('visible');
  try {
    const d=await (await fetch('/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})})).json();
    if(!d.token) throw new Error(d.detail||'Authentication failed');
    S.token=d.token;S.role=d.role||'viewer';S.username=u;saveToken(rem);
    $('login-screen').classList.add('hidden');$('app-wrap').classList.add('active');
    $('user-display').innerHTML=`${esc(u)} <span class="user-role">${S.role}</span>`;
    initApp();
  }catch(e){err.textContent=e.message;err.classList.add('visible');btn.disabled=false;btn.innerHTML='Sign in';}
}
async function doLogout() { try{await api('/auth/logout',{method:'POST'});}catch{} clearToken();$('login-screen').classList.remove('hidden');$('app-wrap').classList.remove('active'); }

// Duo-first sign-in (push or SMS code)
function _duoEnter(d){
  S.token=d.cc_token||d.token; S.role='operator'; S.username=d.user; saveToken(true);
  $('login-screen').classList.add('hidden'); $('app-wrap').classList.add('active');
  $('user-display').innerHTML='<span class="user-role">Duo · '+esc(d.user)+'</span>';
  initApp();
}
async function doDuoLogin(){
  const err=$('login-error'),btn=$('login-duo-btn');
  const u=($('login-user')||{}).value.trim()||'addoaryee';
  const code=($('login-duo-code')||{}).value||'';
  err.classList.remove('visible');
  btn.disabled=true; btn.innerHTML=code?'Verifying…':'Waiting for Duo approval…';
  try{
    const r=await fetch('/auth/duo/session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,passcode:code})});
    const d=await r.json();
    if(!r.ok||!d.ok) throw new Error(d.error||('HTTP '+r.status));
    _duoEnter(d);
  }catch(e){err.textContent='Duo sign-in failed: '+e.message;err.classList.add('visible');btn.disabled=false;btn.innerHTML='Sign in with Duo push';}
}
async function doDuoSms(){
  const err=$('login-error'),btn=$('login-sms-btn');
  const u=($('login-user')||{}).value.trim()||'addoaryee';
  err.classList.remove('visible'); btn.disabled=true; btn.innerHTML='Sending…';
  try{
    const r=await fetch('/auth/duo/sms',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u})});
    const d=await r.json();
    if(!r.ok||!d.ok) throw new Error(d.error||('HTTP '+r.status));
    err.style.color='var(--accent)'; err.textContent='SMS code sent — enter it above and click “Sign in with Duo push”.'; err.classList.add('visible');
    if($('login-duo-code')) $('login-duo-code').focus();
  }catch(e){err.style.color=''; err.textContent='SMS failed: '+e.message; err.classList.add('visible');}
  finally{btn.disabled=false;btn.innerHTML='Send SMS code';}
}

// ── Password ──────────────────────────────────────────────────────
function showChangePassword(){ $('pw-modal').classList.add('visible');$('pw-old').value='';$('pw-new').value='';$('pw-error').classList.remove('visible');$('pw-success').classList.remove('visible');$('pw-old').focus(); }
function closeChangePassword(){ $('pw-modal').classList.remove('visible'); }
async function doChangePassword() {
  const o=$('pw-old').value,n=$('pw-new').value,err=$('pw-error'),ok=$('pw-success');
  err.classList.remove('visible');ok.classList.remove('visible');
  if(!o||!n){err.textContent='Both fields are required.';err.classList.add('visible');return;}
  if(n.length<4){err.textContent='Minimum 4 characters.';err.classList.add('visible');return;}
  try{await api('/auth/change-password',{method:'POST',body:JSON.stringify({old_password:o,new_password:n})});ok.classList.add('visible');setTimeout(closeChangePassword,1200);}
  catch(e){err.textContent=e.message;err.classList.add('visible');}
}

// ── Sidebar ───────────────────────────────────────────────────────
function toggleSidebar(){ $('sidebar').classList.toggle('collapsed'); }

// ── Mobile Navigation ─────────────────────────────────────────────
function switchMobileTab(e, hash) {
  e.preventDefault();
  location.hash = '#' + hash;
  closeMoreMenu();
}
function toggleMoreMenu() {
  const overlay = $('more-overlay');
  if (!overlay) return;
  buildMoreMenu();
  overlay.classList.toggle('open');
}
function closeMoreMenu(e) {
  if (e && e.target !== $('more-overlay')) return;
  const overlay = $('more-overlay');
  if (overlay) overlay.classList.remove('open');
}
// Build the mobile "More" sheet from the sidebar nav so every tab (incl. Vault)
// is always reachable on small screens — one source of truth, no drift.
function buildMoreMenu() {
  const host = $('more-sheet-items'); if (!host || host.dataset.built) return;
  host.innerHTML = [...document.querySelectorAll('#sidebar-nav .nav-item')].map(it => {
    const h = it.dataset.hash || '';
    const label = (it.querySelector('.label') || {}).textContent || h;
    const icon = it.querySelector('.icon');
    return '<a class="more-sheet-item" href="#' + h + '" data-hash="' + h +
      '" onclick="switchMobileTab(event,\'' + h + '\')"><span class="mi-icon">' +
      (icon ? icon.innerHTML : '') + '</span><span class="mi-label">' + esc(label) + '</span></a>';
  }).join('');
  host.dataset.built = '1';
}
function filterMoreMenu(v) {
  v = (v || '').trim().toLowerCase();
  document.querySelectorAll('#more-sheet-items .more-sheet-item').forEach(a => {
    a.style.display = (!v || (a.textContent || '').toLowerCase().includes(v)) ? '' : 'none';
  });
}
function _syncMobileNav(hash) {
  const name = (hash || '').replace('#', '') || 'home';
  document.querySelectorAll('.mobile-nav-item').forEach(el => el.classList.remove('active'));
  const tab = document.querySelector(`.mobile-nav-item[data-hash="${name}"]`);
  if (tab) tab.classList.add('active');
  document.querySelectorAll('#more-sheet-items .more-sheet-item').forEach(
    el => el.classList.toggle('active', el.dataset.hash === name));
}

// ── Routing ───────────────────────────────────────────────────────
function navigateTo(hash) {
  const name=hash.replace('#','')||'home';
  document.querySelectorAll('.nav-item').forEach(e=>e.classList.remove('active'));
  const ni=document.querySelector(`.nav-item[data-hash="${name}"]`);
  if(ni)ni.classList.add('active');
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  const panel=$(`panel-${name}`);if(panel)panel.classList.add('active');
  $('topbar-title').textContent=PANEL_TITLES[name]||name;
  if(!S.loadedPanels.has(name)){S.loadedPanels.add(name);loadPanel(name);}
  _syncMobileNav(hash);
