async function loadBackups(){
  const el=$('backups-content'); if(!el) return; el.innerHTML='<span class="loading">loading…</span>';
  try{
    const d=await api('/api/backups').catch(e=>({error:e.message}));
    if(d.error){el.innerHTML='<span class="error-text">'+esc(d.error)+'</span>';return;}
    const px=await api('/api/backups/proxmox').catch(()=>({jobs:[],artifacts:[],storage:{}}));
    const list=d.backups||[]; const latest=d.latest||{};
    const sz=n=>!n?'—':(n>=1e9?(n/1e9).toFixed(2)+' GB':(n>=1e6?(n/1e6).toFixed(1)+' MB':Math.round(n/1e3)+' KB'));
    const m=(l,v,c)=>'<div class="metric"><span class="val" style="color:'+(c||'var(--accent)')+'">'+esc(v)+'</span><span style="font-size:0.6rem;color:var(--fg-muted)">'+esc(l)+'</span></div>';
    let html='<div class="metric-row">'+m('Backups',list.length)+m('Latest',latest.name?latest.name.slice(4,21):'—','var(--fg)')+m('Size',sz(latest.size_bytes))+m('Verified',list.filter(b=>b.verified).length+' / '+list.length,'var(--accent)')+'</div>';
    html+='<div class="card"><h3>Kai Backup &amp; DR <span class="badge info">'+esc(d.target||'')+'</span> <span class="card-header-actions"><button class="btn btn-xs btn-accent" onclick="bkRun()">Run backup</button><button class="btn btn-xs" onclick="loadBackups()">Refresh</button></span></h3>';
    html+='<p style="font-size:0.62rem;color:var(--fg-muted)">Application-state snapshots (memory, config, second-brain). Checksum-verified; restore drills run to a non-production path.</p>';
    html+='<div class="table-wrap"><table><thead><tr><th>Backup</th><th>Created (UTC)</th><th>Size</th><th>Sources</th><th>SHA-256</th><th>Verified</th><th>Actions</th></tr></thead><tbody>';
    if(!list.length){html+='<tr><td colspan="7" class="empty">no backups yet — run one</td></tr>';}
    for(const b of list){
      const short=(b.sha256||'').slice(0,12);
      html+='<tr><td><code>'+esc(b.name)+'</code></td><td>'+esc(b.created_at||'—')+'</td><td>'+esc(sz(b.size_bytes))+'</td>'
        +'<td style="font-size:0.6rem">'+esc((b.sources||[]).join(', '))+'</td><td><code title="'+esc(b.sha256||'')+'">'+esc(short)+'…</code></td>'
        +'<td><span class="badge '+(b.verified?'ok':'bad')+'">'+(b.verified?'ok':'FAIL')+'</span></td>'
        +'<td><button class="btn btn-xs" onclick="bkVerify(\''+esc(b.name)+'\')">Verify</button> '
        +'<button class="btn btn-xs" onclick="bkRestore(\''+esc(b.name)+'\')">Restore drill</button></td></tr>';
    }
    html+='</tbody></table></div><div id="bk-result" style="font-size:0.62rem;color:var(--fg-muted);margin-top:6px"></div></div>';
    // Proxmox image backups (published by the node-side status timer)
    const st=px.storage||{};
    html+='<div class="card"><h3>Proxmox image backups <span class="badge info">'+esc(st.name||'kai-c')+'</span> <span class="card-header-actions"><button class="btn btn-xs" onclick="loadBackups()">Refresh</button></span></h3>';
    html+='<div style="font-size:0.66rem;color:var(--fg-muted);font-family:var(--font-mono);margin-bottom:8px">used '+esc(sz(st.used))+' / '+esc(sz(st.total))+' &middot; free '+esc(sz(st.avail))+'</div>';
    if((px.jobs||[]).length){
      html+='<h4 style="font-size:0.72rem">Jobs</h4><div class="table-wrap"><table><thead><tr><th>Schedule</th><th>Guests</th><th>Mode</th><th>Compress</th><th>Retention</th></tr></thead><tbody>';
      for(const j of px.jobs){html+='<tr><td>'+esc(j.schedule)+'</td><td style="font-size:0.6rem">'+esc(j.vmid)+'</td><td>'+esc(j.mode)+'</td><td>'+esc(j.compress)+'</td><td style="font-size:0.6rem">'+esc(j['prune-backups']||'')+'</td></tr>';}
      html+='</tbody></table></div>';
    }
    const arts=px.artifacts||[];
    html+='<h4 style="font-size:0.72rem;margin-top:10px">Artifacts <span class="badge info">'+arts.length+'</span></h4><div class="table-wrap"><table><thead><tr><th>File</th><th>Guest</th><th>Size</th><th>Age</th><th>Restore command</th></tr></thead><tbody>';
    if(!arts.length){html+='<tr><td colspan="5" class="empty">no image backups yet</td></tr>';}
    for(const a of arts){
      const cmd=(a.type==='lxc')?('pct restore <NEWID> /mnt/kai-c/dump/'+a.file+' --storage local-lvm')
                               :('qmrestore /mnt/kai-c/dump/'+a.file+' <NEWID> --storage local-lvm');
      const age=Math.max(0,Math.round(Date.now()/1000-(a.mtime||0)))+ 's';
      const ageh=Math.round((Date.now()/1000-(a.mtime||0))/3600);
      html+='<tr><td style="font-size:0.6rem"><code>'+esc(a.file)+'</code></td><td>'+esc(a.type)+' '+esc(a.vmid)+'</td><td>'+esc(sz(a.size))+'</td><td>'+esc(ageh>0?ageh+'h':age)+'</td><td><code style="font-size:0.56rem">'+esc(cmd)+'</code></td></tr>';
    }
    html+='</tbody></table></div><p style="font-size:0.6rem;color:var(--fg-muted);margin-top:6px">Image restores run on the Proxmox node into a <b>NEW</b> vmid (replace &lt;NEWID&gt;) — never overwrite a live guest.</p></div>';
    el.innerHTML=html;
  }catch(e){el.innerHTML='<span class="error-text">'+esc(e.message)+'</span>';}
}
