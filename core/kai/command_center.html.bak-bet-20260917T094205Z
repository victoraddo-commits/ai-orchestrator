function renderModuleCard(m){
  const tabs=[{n:'overview',l:'Overview'},{n:'settings',l:'Settings'},{n:'ops',l:'Ops'}];
  if(m.name==='juris-kai'){tabs.push({n:'users',l:'Users'},{n:'referrals',l:'Referrals'});}
  tabs.push({n:'logs',l:'Logs'});
  const tabBtns=tabs.map(t=>`<button class="module-tab-btn" onclick="event.stopPropagation();loadModuleTab('${esc(m.name)}','${t.n}')">${t.l}</button>`).join('');
  return `<div class="module-card" id="mod-${esc(m.name)}">
    <div class="module-card-header" onclick="toggleModule('${esc(m.name)}')">
      <div><span class="mod-name">${esc(m.name)}</span><span style="font-size:0.65rem;color:var(--fg-muted);margin-left:6px">v${esc(m.version||'0.1.0')}</span></div>
      <div style="display:flex;align-items:center;gap:8px;font-size:0.65rem;color:var(--fg-muted)">
        ${(m.capabilities||[]).slice(0,3).map(c=>`<span class="badge info">${esc(c)}</span>`).join('')}
        <span class="mod-caret">&#9654;</span>
      </div></div>
    <div class="module-card-body">
      <div class="module-tabs">${tabBtns}</div>
      <div class="module-tab-content" id="mod-tab-${esc(m.name)}">${esc(m.description||'No description')}</div>
    </div></div>`;
}

function toggleModule(name){const c=document.getElementById(`mod-${name}`);if(c)c.classList.toggle('open');}
function loadModuleTab(mname, tab){
  const card=document.getElementById(`mod-${mname}`);if(!card)return;
  card.querySelectorAll('.module-tab-btn').forEach(b=>b.classList.remove('active'));
  for(const b of card.querySelectorAll('.module-tab-btn')){if(b.textContent.trim().toLowerCase()===tab.toLowerCase()||(tab==='overview'&&b.textContent.trim().toLowerCase()==='overview'))b.classList.add('active');}
  const content=document.getElementById(`mod-tab-${mname}`);if(!content)return;
  const m=S.modules.find(x=>x.name===mname);
  switch(tab){
    case'overview':
      if(mname==='juris-kai'){loadJurisKaiOverview(content);return;}
      if(mname==='susu'){loadSusuOverview(content);return;}
      if(mname==='legal-brain'){loadLegalBrainOverview(content);return;}
      content.innerHTML=m?`<p style="font-size:0.75rem;color:var(--fg-secondary);margin-bottom:8px">${esc(m.description)}</p>
        <div style="font-size:0.68rem;color:var(--fg-muted);font-family:var(--font-mono)">
          <div>Version: ${esc(m.version||'0.1.0')}</div>
          <div>Endpoints: ${(m.endpoints||[]).map(e=>`<code style="background:var(--bg-deep);padding:1px 4px">${esc(e)}</code>`).join(' ')}</div>
          <div>Deps: ${(m.dependencies||[]).join(', ')||'none'}</div>
        </div>`:'<span class="loading">…</span>';
      break;
    case'users':
      if(mname==='juris-kai'){loadJurisKaiUsers(content);return;}
      content.innerHTML='<p class="empty">User management not available for this module</p>';
      break;
    case'referrals':
      if(mname==='juris-kai'){loadJurisKaiReferrals(content);return;}
      content.innerHTML='<p class="empty">Referrals not available for this module</p>';
      break;
    case'settings':
      if(m&&m.settings_schema){let fhtml='';
        for(const[k,cfg]of Object.entries(m.settings_schema)){fhtml+='<div class="settings-field">';
          if(cfg.type==='boolean')fhtml+=`<div class="toggle-row"><label class="toggle-switch"><input type="checkbox" id="cfg-${esc(mname)}-${esc(k)}" ${cfg.default?'checked':''} onchange="updateModuleSetting('${esc(mname)}','${esc(k)}',this.checked,'boolean')"><span class="slider"></span></label><span class="toggle-label">${esc(cfg.label)}</span></div>`;
          else fhtml+=`<label for="cfg-${esc(mname)}-${esc(k)}">${esc(cfg.label)}</label><input type="number" id="cfg-${esc(mname)}-${esc(k)}" value="${cfg.default}" min="${cfg.min||''}" max="${cfg.max||''}" onchange="updateModuleSetting('${esc(mname)}','${esc(k)}',this.value,'number')">`;
          fhtml+='</div>';}
        content.innerHTML=fhtml;}
      else content.innerHTML='<p class="empty">No configurable settings</p>';
      break;
    case'ops':
      if(m&&m.ops_actions){let ohtml=`<div style="font-size:0.72rem;color:var(--fg-muted);margin-bottom:8px;font-family:var(--font-mono)">Available actions:</div>`;
        for(const a of m.ops_actions){ohtml+=`<button class="btn btn-sm" style="margin:0 4px 4px 0" onclick="runModuleOp('${esc(mname)}','${esc(a)}')">${esc(a.replace(/_/g,' '))}</button>`;}
        ohtml+='<div id="mod-op-msg-'+esc(mname)+'" style="margin-top:8px;font-size:0.7rem"></div>';
        content.innerHTML=ohtml;}
      else content.innerHTML='<p class="empty">No operations defined</p>';
      break;
    case'logs':loadModuleLogs(mname).then(h=>{content.innerHTML=h;}).catch(e=>{content.innerHTML=`<span class="error-text">${esc(e.message)}</span>`;});break;
