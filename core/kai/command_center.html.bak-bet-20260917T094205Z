// PWA Service Worker
// ═══════════════════════════════════════════════════════════════════
function registerSW(){
  if(!('serviceWorker' in navigator)) return;
  navigator.serviceWorker.register('/kai/sw.js', {scope: '/'}).then(reg => {
    console.log('Kai SW registered:', reg.scope);
    // Listen for messages from the SW (e.g. background sync, push nav)
    navigator.serviceWorker.addEventListener('message', event => {
      if(event.data?.type === 'navigate' && event.data.url){
        location.hash = event.data.url.replace('/command-center#','');
        if(!event.data.url.includes('#')) location.hash = '';
      }
      if(event.data?.type === 'background-sync' && event.data.tag === 'kai-heartbeat'){
        // Heartbeat pulse — refresh active panel
        handleHashChange();
      }
    });
  }).catch(e => console.warn('SW registration failed:', e));
}
