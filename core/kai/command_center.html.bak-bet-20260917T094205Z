async function sendChat(){
  const input=$('chat-input');
  const text=input.value.trim();
  if(!text) return;

  // Show user message
  const now=new Date().toLocaleTimeString();
  $('chat-messages').insertAdjacentHTML('beforeend',
    `<div class="chat-msg user"><div>${esc(text)}</div><div class="msg-time">${now}</div></div>`);
  input.value='';
  // Show typing indicator
  $('chat-messages').insertAdjacentHTML('beforeend',
    '<div class="chat-typing" id="chat-typing">Kai is thinking…</div>');
  $('chat-messages').scrollTop=$('chat-messages').scrollHeight;
  $('chat-send-btn').disabled=true;

  try{
    const r=await api('/kai/chat',{
      method:'POST',
      body:JSON.stringify({text:text}),
      headers:{'Content-Type':'application/json'},
    });
    // Remove typing indicator
    const typingEl=$('chat-typing'); if(typingEl) typingEl.remove();
    // Show response
    const reply=r.reply||r.message||'No response';
    $('chat-messages').insertAdjacentHTML('beforeend',
      `<div class="chat-msg assistant"><div>${esc(reply)}</div>
       <div class="msg-meta"><span class="msg-time">${now}</span>
       ${r.provider?`<span style="color:var(--fg-muted)">via ${esc(r.provider)}</span>`:''}
       </div></div>`);
    $('chat-messages').scrollTop=$('chat-messages').scrollHeight;
  }catch(e){
    const typingEl=$('chat-typing'); if(typingEl) typingEl.remove();
    $('chat-messages').insertAdjacentHTML('beforeend',
      `<div class="chat-msg assistant"><div style="color:var(--destructive)">Error: ${esc(e.message)}</div></div>`);
  }finally{
    $('chat-send-btn').disabled=false;
    input.focus();
  }
}

function startVoiceInput(){
  if(!('webkitSpeechRecognition' in window||'SpeechRecognition' in window)){
    toast('Voice input not supported in this browser','err'); return;
  }
  const SpeechRecognition=window.SpeechRecognition||window.webkitSpeechRecognition;
  const rec=new SpeechRecognition();
  rec.lang='en-US';
  rec.interimResults=false;
  rec.maxAlternatives=1;
  const btn=$('chat-voice-btn');
  btn.classList.add('listening');
  rec.start();
  rec.onresult=(e)=>{
    const text=e.results[0][0].transcript;
    $('chat-input').value=text;
    btn.classList.remove('listening');
    toast('Voice recognized');
  };
  rec.onerror=(e)=>{
    btn.classList.remove('listening');
    if(e.error!=='aborted') toast('Voice error: '+e.error,'err');
  };
  rec.onend=()=>btn.classList.remove('listening');
}

