    let h='<div class="card"><h3>Autonomy <span class="badge info">Level '+esc(d.level)+'</span></h3><div class="metric-row">'+arbMetric('Real money',d.may_trade_real_money?'allowed':'blocked',d.may_trade_real_money?'var(--warn)':'var(--accent)')+arbMetric('Real capital',d.may_allocate_real_capital?'allowed':'blocked',d.may_allocate_real_capital?'var(--warn)':'var(--accent)')+arbMetric('Approval above',d.requires_human_approval_above)+'</div>';
    if(Array.isArray(d.hard_limits)&&d.hard_limits.length) h+='<div class="muted" style="font-size:0.62rem">Hard limits: '+esc(d.hard_limits.join(', '))+'</div>';
    h+='<h4 style="font-size:0.7rem;margin-top:10px">Set level (0–5)</h4><div class="action-row" style="flex-wrap:wrap;gap:6px">'
      +'<select id="au-level" class="search-input" style="max-width:120px">'+[0,1,2,3,4,5].map(l=>'<option value="'+l+'"'+(l===d.level?' selected':'')+'>Level '+l+'</option>').join('')+'</select>'
      +'<button class="btn btn-xs btn-accent" onclick="arbSetAutonomy()">Set</button></div>'
      +'<div class="muted" style="font-size:0.6rem;margin-top:6px">Level 4+ requires human approval. Real-money levels stay gated by directive §23/§34.</div></div>';
    h+='<div class="card"><h3>PHASE 8 readiness gate <span class="badge bad">real capital disabled</span></h3><div id="au-readiness"><span class="loading">loading…</span></div></div>';
    arbBody(h);
    arbG('/arbitra/readiness').then(rd=>{
      const el=$('au-readiness'); if(!el)return;
      el.innerHTML='<div class="metric-row">'+arbMetric('Ready',rd.ready?'yes':'no',rd.ready?'var(--accent)':'var(--warn)')+arbMetric('Real capital',rd.real_capital_enabled?'enabled':'disabled','var(--accent)')+'</div>'
        +arbTbl(['check','ok','detail'],(rd.checks||[]).map(c=>'<tr><td>'+esc(c.name)+'</td><td><span class="badge '+(c.ok?'ok':'bad')+'">'+(c.ok?'ok':'no')+'</span></td><td class="muted">'+esc(c.detail||'')+'</td></tr>').join(''))
        +'<div class="muted" style="font-size:0.6rem;margin-top:6px">'+esc(rd.note||'')+'</div>';
    }).catch(e=>{const el=$('au-readiness'); if(el) el.innerHTML='<span class="error-text">'+esc(e.message)+'</span>';});
  }catch(e){arbBody('<span class="error-text">'+esc(e.message)+'</span>');}
}
async function arbSetAutonomy(){const l=$('au-level')?Number($('au-level').value):1;try{const d=await arbP('/arbitra/autonomy',{level:l});toast('autonomy set to L'+l);arbTab('autonomy');}catch(e){toast('error: '+e.message,'err');}}

async function arbTThesis(){
  arbBody('<span class="loading">loading…</span>');
  try{
    const d=await arbG('/arbitra/theses');
    const rows=(d.theses||[]).map(t=>'<tr><td>'+esc(t.id)+'</td><td>'+esc(t.venture_id==null?'—':t.venture_id)+'</td><td>'+esc(t.opportunity_id==null?'—':t.opportunity_id)+'</td><td>'+esc((t.thesis||'').slice(0,90))+'</td><td>'+esc(t.confidence==null?'—':t.confidence)+'</td><td>'+esc((t.created_at||'').slice(0,16).replace('T',' '))+'</td></tr>').join('');
    let h='<div class="card"><h3>Investment theses <span class="badge info">'+(d.theses||[]).length+'</span></h3>'+arbTbl(['id','venture','opportunity','thesis','conf','created'],rows)+'</div>';
    h+='<div class="card"><h3>Add thesis</h3><div class="action-row" style="flex-wrap:wrap;gap:6px">'
      +'<input id="th-vid" type="number" class="search-input" placeholder="venture id" style="max-width:130px">'
      +'<input id="th-oid" type="number" class="search-input" placeholder="opportunity id (alt)" style="max-width:190px">'
      +'<input id="th-text" class="search-input" placeholder="thesis" style="max-width:340px">'
      +'<input id="th-conf" type="number" step="0.05" class="search-input" placeholder="confidence 0-1" style="max-width:150px">'
      +'<button class="btn btn-xs btn-accent" onclick="arbAddThesis()">Add</button></div></div>';
    arbBody(h);
  }catch(e){arbBody('<span class="error-text">'+esc(e.message)+'</span>');}
}
async function arbAddThesis(){
  const t=arbVal('th-text'); if(!t){toast('thesis required','err');return;}
  const vid=arbNum('th-vid'), oid=arbNum('th-oid');
  if(vid==null && oid==null){toast('venture or opportunity id required','err');return;}
  const b={thesis:t}; const c=arbNum('th-conf'); if(c!=null)b.confidence=c;
  const p = vid!=null ? '/arbitra/ventures/'+vid+'/thesis' : '/arbitra/opportunities/'+oid+'/thesis';
  try{await arbP(p,b);toast('thesis added');arbTab('thesis');}catch(e){toast('error: '+e.message,'err');}
}
async function arbTDecisions(){
  arbBody('<span class="loading">loading…</span>');
  let h='<div class="card"><h3>Decision engine</h3><div class="action-row" style="flex-wrap:wrap;gap:6px">'
    +'<input id="dc-vid" type="number" class="search-input" placeholder="venture id" style="max-width:130px">'
    +'<input id="dc-oid" type="number" class="search-input" placeholder="opportunity id" style="max-width:160px">'
    +'<button class="btn btn-xs btn-accent" onclick="arbRunDecide()">Decide</button></div>'
    +'<div id="dc-result" style="margin-top:8px"></div></div>';
  h+='<div class="card"><h3>Capital allocation (advisory)</h3><div class="action-row" style="flex-wrap:wrap;gap:6px">'
    +'<input id="al-vid" type="number" class="search-input" placeholder="venture id" style="max-width:130px">'
    +'<input id="al-amt" type="number" class="search-input" placeholder="amount" style="max-width:130px">'
    +'<button class="btn btn-xs btn-accent" onclick="arbRunAllocate()">Allocate (advisory)</button></div>'
    +'<div id="al-result" style="margin-top:8px"></div>'
    +'<div class="muted" style="font-size:0.6rem;margin-top:6px">Advisory only — a money-center capital request is filed when an operation is linked; execution requires user approval.</div></div>';
  h+='<div class="card"><h3>Economic events</h3><div id="dc-events"><span class="loading">loading…</span></div></div>';
  arbBody(h);
  try{const d=await arbG('/arbitra/decisions');
    $('dc-events').innerHTML=arbTbl(['id','type','venture','at'],(d.events||[]).map(e=>'<tr><td>'+esc(e.id)+'</td><td>'+esc(e.event_type||'')+'</td><td>'+esc(e.venture_id==null?'—':e.venture_id)+'</td><td>'+esc((e.created_at||'').slice(0,16).replace('T',' '))+'</td></tr>').join(''));
  }catch(e){$('dc-events').innerHTML='<span class="error-text">'+esc(e.message)+'</span>';}
}
async function arbRunDecide(){
  const el=$('dc-result'); if(!el)return; el.innerHTML='<span class="loading">…</span>';
  const b={}; const vid=arbNum('dc-vid'); if(vid!=null)b.venture_id=vid; const oid=arbNum('dc-oid'); if(oid!=null)b.opportunity_id=oid;
  if(!Object.keys(b).length){toast('venture or opportunity id required','err');el.innerHTML='';return;}
  try{const d=await arbP('/arbitra/decide',b);
    el.innerHTML='<div class="metric-row">'+arbMetric('Action',d.action,'var(--warn)')+arbMetric('Approval',d.required_approval?'required':'not required')+'</div><div class="muted" style="font-size:0.62rem">'+esc((d.reasons||[]).join(' · '))+'</div>';
  }catch(e){el.innerHTML='<span class="error-text">'+esc(e.message)+'</span>';}
}
async function arbRunAllocate(){
  const el=$('al-result'); if(!el)return; el.innerHTML='<span class="loading">…</span>';
  const vid=arbNum('al-vid'), amt=arbNum('al-amt');
  if(vid==null||amt==null){toast('venture id and amount required','err');el.innerHTML='';return;}
  try{const d=await arbP('/arbitra/allocate',{venture_id:vid,amount:amt});
    const c=d.checks||{};
    el.innerHTML='<div class="metric-row">'+arbMetric('Recommendation',d.recommendation,'var(--warn)')+arbMetric('Max allowed',c.max_allowed==null?'—':c.max_allowed)+arbMetric('Available',c.available==null?'—':c.available)+arbMetric('Policy',d.policy?d.policy.name:'—')+'</div>'
      +((c.violations&&c.violations.length)?'<div class="error-text" style="font-size:0.62rem">'+esc(c.violations.join(' · '))+'</div>':'')
      +((d.capital_request)?'<pre style="font-size:0.6rem;white-space:pre-wrap">'+esc(JSON.stringify(d.capital_request,null,1))+'</pre>':'');
  }catch(e){el.innerHTML='<span class="error-text">'+esc(e.message)+'</span>';}
}
async function arbTActivity(){
  arbBody('<span class="loading">loading…</span>');
  const g=async p=>{try{return await arbG(p);}catch(e){return {error:e.message};}};
  const [ev,ls]=await Promise.all([g('/arbitra/decisions'),g('/arbitra/lessons')]);
  let h='<div class="card"><h3>Economic events</h3>';
  if(ev.error)h+='<span class="error-text">'+esc(ev.error)+'</span>';
  else h+='<div class="table-wrap"><table><thead><tr><th>id</th><th>type</th><th>venture</th><th>at</th></tr></thead><tbody>'+(ev.events||[]).map(e=>'<tr><td>'+esc(e.id)+'</td><td>'+esc(e.event_type||'')+'</td><td>'+esc(e.venture_id==null?'—':e.venture_id)+'</td><td>'+esc((e.created_at||'').slice(0,16).replace('T',' '))+'</td></tr>').join('')+'</tbody></table></div>';
  h+='</div>';
  h+='<div class="card"><h3>Business lessons</h3>';
  if(ls.error)h+='<span class="error-text">'+esc(ls.error)+'</span>';
  else h+=arbTbl(['venture','outcome','reason','at'],(ls.lessons||[]).map(x=>'<tr><td>'+esc(x.venture_id)+'</td><td>'+esc(x.outcome||'')+'</td><td>'+esc((x.reason||'').slice(0,70))+'</td><td>'+esc((x.created_at||'').slice(0,16).replace('T',' '))+'</td></tr>').join(''));
  h+='</div>';
  arbBody(h);
}

async function ccTgBots(){const el=$('cc-tg-result');try{el.innerHTML='<pre style="font-size:0.6rem;white-space:pre-wrap">'+esc(JSON.stringify(await api('/api/cc/telegram/bots'),null,1))+'</pre>';}catch(e){el.textContent=e.message;}}
async function ccTgSetCmds(){const el=$('cc-tg-result');el.textContent='setting…';try{const d=await api('/api/cc/telegram/set-commands',{method:'POST',body:JSON.stringify({bot_id:'kai-enzo-bot'})});el.textContent='set-commands → '+JSON.stringify(d);}catch(e){el.textContent='error: '+e.message;}}
async function ccTgSend(){const el=$('cc-tg-result');const c=($('cc-tg-chat')||{}).value,t=($('cc-tg-text')||{}).value;el.textContent='sending…';try{const d=await api('/api/cc/telegram/send',{method:'POST',body:JSON.stringify({bot_id:'kai-enzo-bot',chat_id:c,text:t})});el.textContent='send → '+JSON.stringify(d);}catch(e){el.textContent='error: '+e.message;}}
async function kaiCtl(a){
  const el=$('kai-ctl-result'); if(!el) return;
  const map={status:'/api/command-center/summary',network:'/api/network/overview',vpn:'/api/vpn/status',missions:'/kai/missions',approvals:'/approvals',health:'/health',doctor:'/kai/doctor',guardian:'/kai/guardian'};
  if(a==='help'){ el.innerHTML='Same commands as the Telegram menu: <b>status &middot; network &middot; vpn &middot; missions &middot; approvals &middot; health</b>'; return; }
  el.textContent='running '+a+'…';
  try{const d=await api(map[a]); el.innerHTML='<pre style="font-size:0.6rem;white-space:pre-wrap;max-height:260px;overflow:auto">'+esc(JSON.stringify(d,null,1))+'</pre>';}
  catch(e){ el.textContent=a+' → error: '+e.message; }
}
// ── Command Palette (§9) ──────────────────────────────────────────
function paletteCommands(){
  const cmds=[];
  document.querySelectorAll('.nav-item').forEach(a=>{
    const lbl=(a.querySelector('.label')||{}).textContent||a.dataset.hash;
    cmds.push({label:'Go to '+lbl, run:()=>{location.hash=a.dataset.hash;}});
  });
  cmds.push({label:'Doctor — system diagnostics', run:()=>{location.hash='#home'; setTimeout(()=>kaiCtl('doctor'),120);}});
  cmds.push({label:'Guardian — architecture scan', run:()=>{location.hash='#home'; setTimeout(()=>kaiCtl('guardian'),120);}});
  cmds.push({label:'Run discovery — network', run:()=>{location.hash='#network'; setTimeout(()=>nwAction('/network/discover'),200);}});
  cmds.push({label:'Refresh current tab', run:()=>{loadPanel((location.hash||'#home').slice(1));}});
  return cmds;
}
function paletteRender(q){
  const el=$('palette-results'); if(!el) return; q=(q||'').toLowerCase();
  const list=paletteCommands().filter(c=>c.label.toLowerCase().includes(q)).slice(0,12);
  el.innerHTML=list.map((c,i)=>'<div class="palette-item" data-i="'+i+'">'+esc(c.label)+'</div>').join('')||'<div class="palette-item" style="color:var(--fg-muted)">no matches</div>';
  el.querySelectorAll('.palette-item').forEach(d=>{d.onclick=()=>{const c=list[+d.dataset.i]; if(c){closePalette();c.run();}};});
}
function openPalette(){const p=$('palette');if(!p)return;p.style.display='flex';const i=$('palette-input');i.value='';paletteRender('');i.focus();}
function closePalette(){const p=$('palette');if(p)p.style.display='none';}
(function(){const pi=$('palette-input');if(pi)pi.addEventListener('input',e=>paletteRender(e.target.value));})();
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();openPalette();}
  else if(e.key==='Escape'){closePalette();}
});
</script>
<div class="modal-overlay" id="palette" style="display:none;align-items:flex-start;justify-content:center">
  <div class="modal-box" style="max-width:560px;width:92%;margin-top:10vh;padding:0">
    <input id="palette-input" autocomplete="off" placeholder="Type a command…  (network · doctor · missions · guardian)" style="width:100%;box-sizing:border-box;padding:14px;font-size:0.9rem;background:var(--bg-deep);color:var(--fg);border:0;border-bottom:1px solid var(--border);outline:none">
    <div id="palette-results" style="max-height:50vh;overflow:auto"></div>
  </div>
</div>
