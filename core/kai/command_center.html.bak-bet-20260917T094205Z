async function loadTelegramActivity(container) {
  try {
    const [act, stats] = await Promise.all([
      api('/api/telegram/activity?limit=200'),
      api('/api/telegram/activity/stats?days=14')
    ]);
    const entries = act.activity || [];
    const daily = stats.daily_stats || [];
    let html = '';
    // Daily chart
    if (daily.length) {
      html += '<div class="card" style="margin-bottom:12px"><h3 style="font-size:0.75rem;margin-bottom:8px">14-Day Activity</h3>';
      html += '<div style="display:flex;gap:2px;align-items:flex-end;height:60px">';
      const maxVal = Math.max(1, ...daily.map(d => (d.inbound||0)+(d.outbound||0)));
      for (const d of daily) {
        const total = (d.inbound||0)+(d.outbound||0);
        const h = Math.max(2, Math.round((total/maxVal)*56));
        html += `<div title="${d.date}: ${total} msgs" style="flex:1;background:var(--accent);height:${h}px;border-radius:1px;opacity:${0.3+(total/maxVal)*0.7}"></div>`;
      }
      html += '</div></div>';
    }
    // Message feed
    if (!entries.length) {
      html += '<p class="empty">No activity logged yet. Messages appear when the assistant logs them.</p>';
    } else {
      html += '<div style="max-height:500px;overflow:auto;font-family:var(--font-mono);font-size:0.65rem;line-height:1.7">';
      for (const e of entries) {
        const dir = e.direction === 'in' ? '←' : '→';
        const dirColor = e.direction === 'in' ? 'var(--info)' : 'var(--accent)';
        const tm = e.timestamp ? new Date(e.timestamp).toLocaleString() : '-';
        html += `<div style="padding:2px 0;border-bottom:1px solid var(--border-subtle)">
          <span style="color:${dirColor};margin-right:4px">${dir}</span>
          <span style="color:var(--fg-muted)">[${tm}]</span>
          <span style="margin-left:6px">${esc(e.from_user_id||'?')}</span>
          <span style="margin-left:2px;color:var(--fg-muted)">${esc(e.chat_type||'dm')}</span>
          <span style="margin-left:6px;color:var(--fg-secondary)">${esc((e.content_preview||'').substring(0,80))}</span>
        </div>`;
      }
      html += '</div>';
    }
    container.innerHTML = html;
  } catch(e) {
    container.innerHTML = `<span class="error-text">${esc(e.message)}</span>`;
  }
}

