[Unit]
Description=Kai Betting — AI Sports Prediction Platform
After=network-online.target ai-orchestrator.service
Wants=network-online.target ai-orchestrator.service

[Service]
Type=simple
User=root
WorkingDirectory=/project/ai-orchestrator
Environment="PYTHONUNBUFFERED=1"
Environment="KAI_BETTING_DB=/project/ai-orchestrator/memory/kai_betting.db"
ExecStart=/project/ai-orchestrator/.venv/bin/python -m core.kai_betting.run_worker
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
